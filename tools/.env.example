# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 로컬 portfolio-images 폴더 경로 ──
PORTFOLIO_DIR=C:/Users/yourname/portfolio-images

# ── Google Sheets (선택) ──
GOOGLE_SERVICE_ACCOUNT_JSON=C:/Users/yourname/service-account.json
GOOGLE_SPREADSHEET_ID=
